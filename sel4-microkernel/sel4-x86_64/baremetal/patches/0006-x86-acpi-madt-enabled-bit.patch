diff --git a/src/plat/pc99/machine/acpi.c b/src/plat/pc99/machine/acpi.c
index 0e0bb7e..e0fa4a9 100644
--- a/src/plat/pc99/machine/acpi.c
+++ b/src/plat/pc99/machine/acpi.c
@@ -110,6 +110,9 @@ enum acpi_table_madt_struct_type {
     MADT_x2APIC = 9
 };
 
+/* Local APIC / x2APIC entry flags (ACPI 6.5, 5.2.12.2) */
+#define MADT_CPU_ENABLED BIT(0)
+
 typedef struct acpi_madt_apic {
     acpi_madt_header_t header;
     uint8_t            cpu_id;
@@ -416,7 +419,12 @@ BOOT_CODE uint32_t acpi_madt_scan(
                     /* what Intel calls apic_id is what is called cpu_id in seL4! */
                     uint8_t  cpu_id = madt_apic->apic_id;
                     uint32_t flags  = madt_apic->flags;
-                    if (flags == 1) {
+                    /* Bit 0 = Enabled. ACPI 6.3 added bit 1 = Online Capable, which
+                     * VMMs (e.g. Cloud Hypervisor) and newer firmware set alongside
+                     * Enabled, so an exact match on 1 rejects every CPU. */
+                    if (!(flags & MADT_CPU_ENABLED)) {
+                        printf("ACPI: MADT_APIC apic_id=0x%x flags=0x%x not enabled, skipped\n", cpu_id, flags);
+                    } else {
                         printf("ACPI: MADT_APIC apic_id=0x%x\n", cpu_id);
                         if (num_cpu == CONFIG_MAX_NUM_NODES) {
                             printf("ACPI: Not recording this APIC, only support %d\n", CONFIG_MAX_NUM_NODES);
@@ -435,7 +443,9 @@ BOOT_CODE uint32_t acpi_madt_scan(
 
                     uint32_t cpu_id = madt_x2apic->x2apic_id;
                     uint32_t flags  = madt_x2apic->flags;
-                    if (flags == 1) {
+                    if (!(flags & MADT_CPU_ENABLED)) {
+                        printf("ACPI: MADT_x2APIC apic_id=0x%x flags=0x%x not enabled, skipped\n", cpu_id, flags);
+                    } else {
                         printf("ACPI: MADT_x2APIC apic_id=0x%x\n", cpu_id);
                         if (num_cpu == CONFIG_MAX_NUM_NODES) {
                             printf("ACPI: Not recording this APIC, only support %d\n", CONFIG_MAX_NUM_NODES);
