diff --git a/src/arch/x86/kernel/boot_sys.c b/src/arch/x86/kernel/boot_sys.c
index 960c3c8..521c80b 100644
--- a/src/arch/x86/kernel/boot_sys.c
+++ b/src/arch/x86/kernel/boot_sys.c
@@ -450,7 +450,11 @@ static BOOT_CODE bool_t try_boot_sys(void)
     }
 
     mods_end_paddr = ROUND_UP(mods_end_paddr, PAGE_BITS);
-    assert(mods_end_paddr > boot_state.ki_p_reg.end);
+    /* GRUB on UEFI may place modules below the kernel image; ELF-load into
+     * scratch space above both. (The final copy below then has src == dst.) */
+    if (mods_end_paddr < boot_state.ki_p_reg.end) {
+        mods_end_paddr = boot_state.ki_p_reg.end;
+    }
 
     printf("ELF-loading userland images from boot modules:\n");
     load_paddr = mods_end_paddr;
@@ -470,7 +474,9 @@ static BOOT_CODE bool_t try_boot_sys(void)
         ui_p_regs.start,
         ui_p_regs.end - ui_p_regs.start
     );
-    memcpy((void *)ui_p_regs.start, (void *)mods_end_paddr, ui_p_regs.end - ui_p_regs.start);
+    if (ui_p_regs.start != mods_end_paddr) {
+        memcpy((void *)ui_p_regs.start, (void *)mods_end_paddr, ui_p_regs.end - ui_p_regs.start);
+    }
 
     /* adjust p_reg and pv_offset to final load address */
     boot_state.ui_info.p_reg.start -= mods_end_paddr - ui_p_regs.start;
