-void kernel_putDebugChar(unsigned char c)
+/*
+ * BOOTPROF console (measurement builds only; not the verified kernel).
+ *
+ * 1. Output is buffered in memory until the root task's first
+ *    seL4_DebugPutChar (or halt()), so serial/screen I/O does not inflate the
+ *    boot timestamps. The root task samples the TSC before it prints.
+ * 2. Besides COM1, output goes to the boot loader's multiboot2 framebuffer:
+ *    EGA text (legacy BIOS) or 24/32bpp linear RGB (UEFI GOP), the latter
+ *    drawn with an 8x8 font, scaled so ~80 columns fit. No scrolling: the
+ *    cursor wraps to the top, clearing each line before it is reused.
+ */
+#include <arch/bootprof_font8x8.h>
+
+#define BOOTPROF_BUF_SIZE 16384
+static char bootprof_buf[BOOTPROF_BUF_SIZE];
+static word_t bootprof_buf_len;
+static bool_t bootprof_live;
+static bool_t bootprof_overflowed;
+
+static multiboot2_fb_t bootprof_fb;
+static uint8_t *bootprof_fb_base;   /* kernel-window pointer; NULL = no screen */
+static word_t bootprof_cols, bootprof_rows, bootprof_scale, bootprof_pos;
+
+#define FB_TYPE_RGB 1
+#define FB_TYPE_EGA_TEXT 2
+#define EGA_ATTR 0x0700u
+
+void bootprof_screen_init(const multiboot2_fb_t *fb)
+{
+    bootprof_fb = *fb;
+}
+
+/* Map lazily (at first flush), when the full kernel window exists; the boot
+ * page tables only cover the low 4 GiB and GOP framebuffers may sit higher. */
+static bool_t bootprof_screen_map(void)
+{
+    multiboot2_fb_t const *fb = &bootprof_fb;
+    word_t bytespp = fb->bpp / 8;
+    if (fb->addr == 0 || fb->width == 0 || fb->height == 0) {
+        return false;
+    }
+    if (fb->type == FB_TYPE_EGA_TEXT) {
+        bootprof_cols = fb->width;
+        bootprof_rows = fb->height;
+        bytespp = 2;
+    } else if (fb->type == FB_TYPE_RGB && (fb->bpp == 24 || fb->bpp == 32)) {
+        bootprof_scale = fb->width / (80 * 8);
+        bootprof_scale = bootprof_scale < 1 ? 1 : (bootprof_scale > 4 ? 4 : bootprof_scale);
+        bootprof_cols = fb->width / (8 * bootprof_scale);
+        bootprof_rows = fb->height / (8 * bootprof_scale);
+    } else {
+        return false;
+    }
+    if (fb->pitch < fb->width * bytespp ||
+        fb->addr + (uint64_t)fb->pitch * fb->height > PADDR_TOP) {
+        return false;
+    }
+    bootprof_fb_base = (uint8_t *)paddr_to_pptr(fb->addr);
+    return true;
+}
+
+static void bootprof_cell(word_t pos, unsigned char c)
+{
+    multiboot2_fb_t const *fb = &bootprof_fb;
+    if (fb->type == FB_TYPE_EGA_TEXT) {
+        ((volatile uint16_t *)bootprof_fb_base)[pos] = EGA_ATTR | c;
+        return;
+    }
+    if (c < BOOTPROF_FONT_FIRST || c > BOOTPROF_FONT_LAST) {
+        c = '?';
+    }
+    uint8_t const *glyph = bootprof_font[c - BOOTPROF_FONT_FIRST];
+    word_t bytespp = fb->bpp / 8;
+    word_t x0 = (pos % bootprof_cols) * 8 * bootprof_scale;
+    word_t y0 = (pos / bootprof_cols) * 8 * bootprof_scale;
+    for (word_t y = 0; y < 8 * bootprof_scale; y++) {
+        volatile uint8_t *row = bootprof_fb_base + (y0 + y) * fb->pitch + x0 * bytespp;
+        uint8_t bits = glyph[y / bootprof_scale];
+        for (word_t x = 0; x < 8 * bootprof_scale; x++) {
+            uint8_t v = (bits >> (x / bootprof_scale)) & 1 ? 0xff : 0x00;
+            for (word_t k = 0; k < bytespp; k++) {
+                *row++ = v;
+            }
+        }
+    }
+}
+
+static void bootprof_clear_row(word_t row)
+{
+    for (word_t i = 0; i < bootprof_cols; i++) {
+        bootprof_cell(row * bootprof_cols + i, ' ');
+    }
+}
+
+static void bootprof_screen_putchar(unsigned char c)
+{
+    if (!bootprof_fb_base || c == '\r') {
+        return;
+    }
+    if (c == '\n') {
+        bootprof_pos += bootprof_cols - (bootprof_pos % bootprof_cols);
+    } else {
+        bootprof_cell(bootprof_pos++, c);
+    }
+    if (bootprof_pos >= bootprof_cols * bootprof_rows) {
+        bootprof_pos = 0;
+    }
+    if (bootprof_pos % bootprof_cols == 0) {
+        bootprof_clear_row(bootprof_pos / bootprof_cols);
+    }
+}
+
+static void bootprof_emit(unsigned char c)
 {
+    bootprof_screen_putchar(c);
     /* this will take care of CR/LF handling and call uart_drv_putchar() */
     uart_console_putchar(c);
 }
 
+void bootprof_flush(void)
+{
+    if (bootprof_live) {
+        return;
+    }
+    bootprof_live = true;
+    uint64_t t0 = x86_rdtsc();
+    if (bootprof_screen_map()) {
+        for (word_t r = 0; r < bootprof_rows; r++) {
+            bootprof_clear_row(r);
+        }
+    }
+    for (word_t i = 0; i < bootprof_buf_len; i++) {
+        bootprof_emit(bootprof_buf[i]);
+    }
+    /* Deferring output keeps it out of the boot timestamps but not out of
+     * time-to-ready: report what the flush cost (serial PIO exits under a VMM,
+     * framebuffer writes on hardware). early=1: the buffer overflowed during
+     * boot, so console I/O did land inside the measured window. */
+    uint64_t t1 = x86_rdtsc();
+    printf("BOOTPROF flush bytes=%lu early=%u flush_us=%llu done_us=%llu\n",
+           (unsigned long)bootprof_buf_len, (unsigned)bootprof_overflowed,
+           (unsigned long long)(bootprof_tsc_mhz ? (t1 - t0) / bootprof_tsc_mhz : 0),
+           (unsigned long long)(bootprof_tsc_mhz ? t1 / bootprof_tsc_mhz : 0));
+}
+
+void kernel_putDebugChar(unsigned char c)
+{
+    if (!bootprof_live) {
+        if (bootprof_buf_len < BOOTPROF_BUF_SIZE) {
+            bootprof_buf[bootprof_buf_len++] = c;
+            return;
+        }
+        bootprof_overflowed = true;
+        bootprof_flush();
+    }
+    bootprof_emit(c);
+}
+
