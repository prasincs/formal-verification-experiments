diff --git a/include/arch/x86/arch/bootprof.h b/include/arch/x86/arch/bootprof.h
new file mode 100644
index 0000000..e4e9a86
--- /dev/null
+++ b/include/arch/x86/arch/bootprof.h
@@ -0,0 +1,17 @@
+/*
+ * BOOTPROF: boot-time instrumentation for bare-metal measurement builds.
+ * Not part of the verified kernel configuration.
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+#pragma once
+
+#include <types.h>
+#include <arch/kernel/multiboot2.h>
+
+extern uint64_t bootprof_tsc_init_cycles;
+extern uint32_t bootprof_tsc_mhz;
+/* Record the boot loader's framebuffer for the BOOTPROF console. */
+void bootprof_screen_init(const multiboot2_fb_t *fb);
+/* Stop buffering console output and write it out. Idempotent. */
+void bootprof_flush(void);
