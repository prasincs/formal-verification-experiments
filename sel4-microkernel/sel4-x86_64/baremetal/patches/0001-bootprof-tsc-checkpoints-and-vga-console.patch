+#include <arch/bootprof.h>
 #include <config.h>
 #include <arch/kernel/boot_sys.h>
 #include <arch/model/statedata.h>
@@ -41,8 +42,49 @@ void uart_drv_putchar(
     out8(x86KSdebugPort, c);
 }
 
+/* BOOTPROF: mirror the debug console to an 80x25 EGA text buffer when the
+ * boot loader reports one (multiboot2 framebuffer type 2). For machines
+ * without a UART. Measurement builds only; not part of the verified kernel. */
+static volatile uint16_t *bootprof_vga;
+static word_t bootprof_vga_pos;
+#define BOOTPROF_VGA_COLS 80
+#define BOOTPROF_VGA_ROWS 25
+#define BOOTPROF_VGA_ATTR 0x0700u
+
+void bootprof_vga_enable(paddr_t addr)
+{
+    bootprof_vga = (volatile uint16_t *)paddr_to_pptr(addr);
+    for (word_t i = 0; i < BOOTPROF_VGA_COLS * BOOTPROF_VGA_ROWS; i++) {
+        bootprof_vga[i] = BOOTPROF_VGA_ATTR | ' ';
+    }
+    bootprof_vga_pos = 0;
+}
+
+static void bootprof_vga_putchar(unsigned char c)
+{
+    if (!bootprof_vga || c == '\r') {
+        return;
+    }
+    if (c == '\n') {
+        bootprof_vga_pos += BOOTPROF_VGA_COLS - (bootprof_vga_pos % BOOTPROF_VGA_COLS);
+    } else {
+        bootprof_vga[bootprof_vga_pos++] = BOOTPROF_VGA_ATTR | c;
+    }
+    if (bootprof_vga_pos >= BOOTPROF_VGA_COLS * BOOTPROF_VGA_ROWS) {
+        word_t last = BOOTPROF_VGA_COLS * (BOOTPROF_VGA_ROWS - 1);
+        for (word_t i = 0; i < last; i++) {
+            bootprof_vga[i] = bootprof_vga[i + BOOTPROF_VGA_COLS];
+        }
+        for (word_t i = last; i < last + BOOTPROF_VGA_COLS; i++) {
+            bootprof_vga[i] = BOOTPROF_VGA_ATTR | ' ';
+        }
+        bootprof_vga_pos = last;
+    }
+}
+
 void kernel_putDebugChar(unsigned char c)
 {
+    bootprof_vga_putchar(c);
     /* this will take care of CR/LF handling and call uart_drv_putchar() */
     uart_console_putchar(c);
 }
