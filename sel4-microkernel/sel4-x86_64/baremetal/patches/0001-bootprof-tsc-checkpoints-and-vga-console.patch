@@ -701,10 +707,18 @@ static BOOT_CODE bool_t try_boot_sys_mbi2(
     return true;
 }
 
+static inline uint64_t bootprof_us(uint64_t cycles)
+{
+    return bootprof_tsc_mhz ? cycles / bootprof_tsc_mhz : 0;
+}
+
 BOOT_CODE VISIBLE void boot_sys(
     unsigned long multiboot_magic,
     void *mbi)
 {
+    /* BOOTPROF: first instruction of C boot code. The TSC counts from reset,
+     * so this value also approximates firmware + boot loader time. */
+    uint64_t bootprof_entry = x86_rdtsc();
     bool_t result = false;
 
     if (multiboot_magic == MULTIBOOT_MAGIC) {
@@ -726,6 +740,16 @@ BOOT_CODE VISIBLE void boot_sys(
     ARCH_NODE_STATE(x86KScurInterrupt) = int_invalid;
     ARCH_NODE_STATE(x86KSPendingInterrupt) = int_invalid;
 
+    uint64_t bootprof_exit = x86_rdtsc();
+    /* Two lines so each fits an 80-column text console. */
+    printf("BOOTPROF kernel tsc_mhz=%u tsc_init_us=%llu\n",
+           bootprof_tsc_mhz,
+           (unsigned long long)bootprof_us(bootprof_tsc_init_cycles));
+    printf("BOOTPROF kernel entry_us=%llu exit_us=%llu kernel_us=%llu\n",
+           (unsigned long long)bootprof_us(bootprof_entry),
+           (unsigned long long)bootprof_us(bootprof_exit),
+           (unsigned long long)bootprof_us(bootprof_exit - bootprof_entry));
+
 #ifdef CONFIG_KERNEL_MCS
     NODE_STATE(ksCurTime) = getCurrentTime();
     NODE_STATE(ksConsumed) = 0;
diff --git a/src/plat/pc99/machine/io.c b/src/plat/pc99/machine/io.c
