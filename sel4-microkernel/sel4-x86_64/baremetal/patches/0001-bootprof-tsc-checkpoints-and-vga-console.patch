  */
 
+#include <arch/bootprof.h>
 #include <config.h>
 #include <kernel/boot.h>
 #include <machine/io.h>
@@ -83,6 +84,9 @@ BOOT_CODE static bool_t arch_init_freemem(p_region_t ui_p_reg,
 
 /* This function initialises a node's kernel state. It does NOT initialise the CPU. */
 
+uint64_t bootprof_tsc_init_cycles;
+uint32_t bootprof_tsc_mhz;
+
 BOOT_CODE bool_t init_sys_state(
     cpu_id_t      cpu_id,
     mem_p_regs_t  *mem_p_regs,
@@ -170,7 +174,10 @@ BOOT_CODE bool_t init_sys_state(
     /* initialise the IRQ states and provide the IRQ control cap */
     init_irqs(root_cnode_cap);
 
+    uint64_t bootprof_t = x86_rdtsc();
     tsc_freq = tsc_init();
+    bootprof_tsc_init_cycles = x86_rdtsc() - bootprof_t;
+    bootprof_tsc_mhz = tsc_freq;
 
     /* populate the bootinfo frame */
     populate_bi_frame(0, ksNumCPUs, ipcbuf_vptr, extra_bi_size);
