     UNQUOTE UNDEF_DISABLED
 )
+
+config_string(
+    KernelPC99APICTimerFrequency PC99_APIC_TIMER_FREQUENCY
+    "Provide a static definition of the local APIC timer frequency (in Hz, divisor 1). \
+    If this isn't set then the boot code measures it against the PIT, which takes 50-100ms. \
+    On Skylake and later Intel CPUs this is the core crystal clock (CPUID 0x15 ECX, \
+    24 MHz on client parts); under KVM and QEMU it is 1 GHz."
+    DEFAULT 0
+    DEPENDS "KernelPlatPC99"
+    UNQUOTE UNDEF_DISABLED
+)
