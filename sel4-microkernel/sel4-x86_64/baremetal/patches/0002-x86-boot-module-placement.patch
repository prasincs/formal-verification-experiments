diff --git a/src/arch/x86/kernel/boot_sys.c b/src/arch/x86/kernel/boot_sys.c
index 960c3c8..68126dc 100644
--- a/src/arch/x86/kernel/boot_sys.c
+++ b/src/arch/x86/kernel/boot_sys.c
@@ -66,9 +66,10 @@ BOOT_CODE static paddr_t find_load_paddr(paddr_t min_paddr, word_t image_size)
     for (i = 0; i < boot_state.mem_p_regs.count; i++) {
         paddr_t start = MAX(min_paddr, boot_state.mem_p_regs.list[i].start);
         paddr_t end = boot_state.mem_p_regs.list[i].end;
-        word_t region_size = end - start;
 
-        if (region_size >= image_size) {
+        /* min_paddr may lie beyond this region: end - start would underflow
+         * and "fit" anything, returning an address that is not RAM. */
+        if (start < end && end - start >= image_size) {
             return start;
         }
     }
@@ -118,7 +119,10 @@ BOOT_CODE static paddr_t load_boot_module(word_t boot_module_start, paddr_t load
     }
 
     load_paddr = find_load_paddr(load_paddr, v_reg.end - v_reg.start);
-    assert(load_paddr);
+    if (!load_paddr) {
+        printf("No RAM region can hold the userland image\n");
+        return 0;
+    }
 
     /* fill ui_info struct */
     boot_state.ui_info.pv_offset = load_paddr - v_reg.start;
@@ -450,7 +454,25 @@ static BOOT_CODE bool_t try_boot_sys(void)
     }
 
     mods_end_paddr = ROUND_UP(mods_end_paddr, PAGE_BITS);
-    assert(mods_end_paddr > boot_state.ki_p_reg.end);
+    /* The user image ends up right after the kernel image. Upstream always
+     * ELF-loads into scratch space just above the modules and copies down,
+     * which assumes RAM continues past them. That breaks when the loader puts
+     * modules at the top of RAM (PVH: QEMU, Firecracker) and is unnecessary
+     * when they are below the kernel (GRUB on UEFI). Load in place whenever
+     * the destination does not overlap the modules; else keep the scratch
+     * scheme (GRUB on BIOS places modules right after the kernel). */
+    {
+        Elf_Header_t const *elf = (Elf_Header_t const *)boot_state.boot_module_start;
+        paddr_t dst = boot_state.ki_p_reg.end;
+        if (elf_checkFile((Elf_Header_t *)elf)) {
+            v_region_t v = elf_getMemoryBounds((Elf_Header_t *)elf);
+            word_t size = ROUND_UP(v.end, PAGE_BITS) - v.start;
+            if (dst + size <= ROUND_DOWN(boot_state.boot_module_start, PAGE_BITS) ||
+                dst >= mods_end_paddr) {
+                mods_end_paddr = dst; /* "scratch" == destination: no copy */
+            }
+        }
+    }
 
     printf("ELF-loading userland images from boot modules:\n");
     load_paddr = mods_end_paddr;
@@ -459,6 +481,14 @@ static BOOT_CODE bool_t try_boot_sys(void)
     if (!load_paddr) {
         return false;
     }
+    /* The size/move arithmetic below (and the in-place decision above) assume
+     * the image was loaded exactly at the scratch base. find_load_paddr() may
+     * pick a later RAM region instead; refuse rather than mis-place it. */
+    if (boot_state.ui_info.p_reg.start != mods_end_paddr) {
+        printf("Userland image loaded at 0x%lx, expected 0x%lx\n",
+               boot_state.ui_info.p_reg.start, mods_end_paddr);
+        return false;
+    }
 
     /* calculate final location of userland images */
     ui_p_regs.start = boot_state.ki_p_reg.end;
@@ -470,7 +500,9 @@ static BOOT_CODE bool_t try_boot_sys(void)
         ui_p_regs.start,
         ui_p_regs.end - ui_p_regs.start
     );
-    memcpy((void *)ui_p_regs.start, (void *)mods_end_paddr, ui_p_regs.end - ui_p_regs.start);
+    if (ui_p_regs.start != mods_end_paddr) {
+        memcpy((void *)ui_p_regs.start, (void *)mods_end_paddr, ui_p_regs.end - ui_p_regs.start);
+    }
 
     /* adjust p_reg and pv_offset to final load address */
     boot_state.ui_info.p_reg.start -= mods_end_paddr - ui_p_regs.start;
