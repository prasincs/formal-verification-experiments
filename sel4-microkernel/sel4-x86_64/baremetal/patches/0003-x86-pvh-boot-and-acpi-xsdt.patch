new file mode 100644
index 0000000..db6ed53
--- /dev/null
+++ b/include/arch/x86/arch/kernel/pvh.h
@@ -0,0 +1,42 @@
+/*
+ * PVH boot ABI (Xen arch-x86/hvm/start_info.h), as implemented by QEMU,
+ * Firecracker and Cloud Hypervisor: entered in 32-bit protected mode, paging
+ * off, at XEN_ELFNOTE_PHYS32_ENTRY, with %ebx = physical address of
+ * struct hvm_start_info.
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+#pragma once
+
+#include <types.h>
+
+#define PVH_START_MAGIC 0x336ec578u
+#define PVH_MEMMAP_TYPE_RAM 1
+
+typedef struct pvh_start_info {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t flags;
+    uint32_t nr_modules;
+    uint64_t modlist_paddr;
+    uint64_t cmdline_paddr;
+    uint64_t rsdp_paddr;
+    /* version >= 1 */
+    uint64_t memmap_paddr;
+    uint32_t memmap_entries;
+    uint32_t reserved;
+} PACKED pvh_start_info_t;
+
+typedef struct pvh_modlist_entry {
+    uint64_t paddr;
+    uint64_t size;
+    uint64_t cmdline_paddr;
+    uint64_t reserved;
+} PACKED pvh_modlist_entry_t;
+
+typedef struct pvh_memmap_entry {
+    uint64_t addr;
+    uint64_t size;
+    uint32_t type;
+    uint32_t reserved;
+} PACKED pvh_memmap_entry_t;
