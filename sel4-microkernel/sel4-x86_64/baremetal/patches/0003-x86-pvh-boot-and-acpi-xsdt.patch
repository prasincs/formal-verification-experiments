 #include <arch/bootprof.h>
 #include <config.h>
 #include <util.h>
@@ -725,6 +726,72 @@ static BOOT_CODE bool_t try_boot_sys_mbi2(
     return true;
 }
 
+static BOOT_CODE bool_t try_boot_sys_pvh(pvh_start_info_t const *si)
+{
+    if (si->magic != PVH_START_MAGIC) {
+        printf("PVH: bad start_info magic %x\n", si->magic);
+        return false;
+    }
+    cmdline_parse(si->cmdline_paddr ? (const char *)(word_t)si->cmdline_paddr : "", &cmdline_opt);
+    printf("PVH: start_info v%u, %u module(s), rsdp=%llx\n",
+           si->version, si->nr_modules, (unsigned long long)si->rsdp_paddr);
+
+    boot_state.mem_p_regs.count = 0;
+    boot_state.mb_mmap_info.mmap_length = 0;
+    boot_state.vbe_info.vbeMode = -1;
+
+    if (si->version < 1 || si->memmap_entries == 0) {
+        printf("PVH: no memory map (start_info version %u)\n", si->version);
+        return false;
+    }
+    pvh_memmap_entry_t const *mm = (pvh_memmap_entry_t const *)(word_t)si->memmap_paddr;
+    for (word_t i = 0; i < si->memmap_entries; i++) {
+        printf("\tPhysical Memory Region from %llx size %llx type %u\n",
+               (unsigned long long)mm[i].addr, (unsigned long long)mm[i].size, mm[i].type);
+        if (!mm[i].addr) {
+            boot_state.mem_lower = mm[i].size;
+        }
+        if (mm[i].type == PVH_MEMMAP_TYPE_RAM && mm[i].addr >= HIGHMEM_PADDR) {
+            if (!add_mem_p_regs((p_region_t) {
+            mm[i].addr, mm[i].addr + mm[i].size
+        })) {
+                return false;
+            }
+        }
+    }
+
+    if (si->nr_modules < 1) {
+        printf("Expect at least one boot module (containing a userland image)\n");
+        return false;
+    }
+    pvh_modlist_entry_t const *mods = (pvh_modlist_entry_t const *)(word_t)si->modlist_paddr;
+    for (word_t i = 0; i < si->nr_modules; i++) {
+        uint64_t end = mods[i].paddr + mods[i].size;
+        printf("  module #%lu: start=0x%llx end=0x%llx\n", i,
+               (unsigned long long)mods[i].paddr, (unsigned long long)end);
+        /* Boot page tables identity-map only the low 4 GiB. */
+        if (mods[i].size == 0 || end > BIT(32) || end < mods[i].paddr) {
+            printf("PVH: invalid module %lu\n", i);
+            return false;
+        }
+        if (i == 0) {
+            boot_state.boot_module_start = mods[i].paddr;
+        }
+        if (boot_state.mods_end_paddr < end) {
+            boot_state.mods_end_paddr = end;
+        }
+    }
+
+    if (si->rsdp_paddr) {
+        if (si->rsdp_paddr >= BIT(32)) {
+            return false;
+        }
+        memcpy(&boot_state.acpi_rsdp, (void *)(word_t)si->rsdp_paddr, sizeof(boot_state.acpi_rsdp));
+        return true;
+    }
+    return acpi_init(&boot_state.acpi_rsdp);
+}
+
 static inline uint64_t bootprof_us(uint64_t cycles)
 {
     return bootprof_tsc_mhz ? cycles / bootprof_tsc_mhz : 0;
@@ -743,6 +810,8 @@ BOOT_CODE VISIBLE void boot_sys(
         result = try_boot_sys_mbi1(mbi);
     } else if (multiboot_magic == MULTIBOOT2_MAGIC) {
         result = try_boot_sys_mbi2(mbi);
+    } else if (multiboot_magic == PVH_START_MAGIC) {
+        result = try_boot_sys_pvh(mbi);
     } else {
         printf("Boot loader is not multiboot 1 or 2 compliant %lx\n", multiboot_magic);
     }
