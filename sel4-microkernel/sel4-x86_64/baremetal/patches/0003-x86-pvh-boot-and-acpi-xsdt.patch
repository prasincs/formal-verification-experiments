+/* [paddr, paddr + len) is non-empty, does not wrap, and lies inside the low
+ * 4 GiB that the boot page tables identity-map (anything else would fault). */
+static BOOT_CODE bool_t pvh_range_ok(uint64_t paddr, uint64_t len)
+{
+    return paddr != 0 && len != 0 && paddr + len > paddr && paddr + len <= BIT(32);
+}
+
+static BOOT_CODE bool_t try_boot_sys_pvh(pvh_start_info_t const *si)
+{
+    if (si->magic != PVH_START_MAGIC) {
+        printf("PVH: bad start_info magic %x\n", si->magic);
+        return false;
+    }
+    if (si->cmdline_paddr && !pvh_range_ok(si->cmdline_paddr, 1)) {
+        printf("PVH: cmdline not below 4 GiB\n");
+        return false;
+    }
+    cmdline_parse(si->cmdline_paddr ? (const char *)(word_t)si->cmdline_paddr : "", &cmdline_opt);
+    printf("PVH: start_info v%u, %u module(s), rsdp=%llx\n",
+           si->version, si->nr_modules, (unsigned long long)si->rsdp_paddr);
+
+    boot_state.mem_p_regs.count = 0;
+    boot_state.mb_mmap_info.mmap_length = 0;
+    boot_state.vbe_info.vbeMode = -1;
+
+    if (si->version < 1 || si->memmap_entries == 0 ||
+        !pvh_range_ok(si->memmap_paddr, (uint64_t)si->memmap_entries * sizeof(pvh_memmap_entry_t))) {
+        printf("PVH: missing or unaddressable memory map (start_info v%u)\n", si->version);
+        return false;
+    }
+    pvh_memmap_entry_t const *mm = (pvh_memmap_entry_t const *)(word_t)si->memmap_paddr;
+    for (word_t i = 0; i < si->memmap_entries; i++) {
+        uint64_t start = mm[i].addr, end = mm[i].addr + mm[i].size;
+        printf("\tPhysical Memory Region from %llx size %llx type %u\n",
+               (unsigned long long)start, (unsigned long long)mm[i].size, mm[i].type);
+        if (end < start) {
+            printf("PVH: memory map entry %lu wraps\n", i);
+            return false;
+        }
+        if (start == 0) {
+            /* KiB, as multiboot1 mem_lower and copy_boot_code_aps() expect */
+            boot_state.mem_lower = MIN(mm[i].size >> 10, 0xffffffffull);
+        }
+        if (mm[i].type != PVH_MEMMAP_TYPE_RAM) {
+            continue;
+        }
+        /* Clip (not drop) RAM that starts below 1 MiB; whole pages only. */
+        start = ROUND_UP(MAX(start, (uint64_t)HIGHMEM_PADDR), PAGE_BITS);
+        end = ROUND_DOWN(end, PAGE_BITS);
+        if (start < end && !add_mem_p_regs((p_region_t) {
+        start, end
+    })) {
+            return false;
+        }
+    }
+
+    if (si->nr_modules < 1 ||
+        !pvh_range_ok(si->modlist_paddr, (uint64_t)si->nr_modules * sizeof(pvh_modlist_entry_t))) {
+        printf("Expect at least one addressable boot module (containing a userland image)\n");
+        return false;
+    }
+    pvh_modlist_entry_t const *mods = (pvh_modlist_entry_t const *)(word_t)si->modlist_paddr;
+    for (word_t i = 0; i < si->nr_modules; i++) {
+        printf("  module #%lu: start=0x%llx size=0x%llx\n", i,
+               (unsigned long long)mods[i].paddr, (unsigned long long)mods[i].size);
+        if (!pvh_range_ok(mods[i].paddr, mods[i].size)) {
+            printf("PVH: module %lu empty, wrapping or above 4 GiB\n", i);
+            return false;
+        }
+        if (i == 0) {
+            boot_state.boot_module_start = mods[i].paddr;
+        }
+        if (boot_state.mods_end_paddr < mods[i].paddr + mods[i].size) {
+            boot_state.mods_end_paddr = mods[i].paddr + mods[i].size;
+        }
+    }
+
+    if (si->rsdp_paddr) {
+        if (!pvh_range_ok(si->rsdp_paddr, sizeof(boot_state.acpi_rsdp))) {
+            printf("PVH: RSDP not below 4 GiB\n");
+            return false;
+        }
+        /* Copies 36 bytes; an ACPI 1.0 RSDP is 20, and the tail is ignored
+         * (acpi_validate_rsdp only checksums the v2 part when revision > 0). */
+        memcpy(&boot_state.acpi_rsdp, (void *)(word_t)si->rsdp_paddr, sizeof(boot_state.acpi_rsdp));
+        return true;
+    }
+    return acpi_init(&boot_state.acpi_rsdp);
+}
+
 static inline uint64_t bootprof_us(uint64_t cycles)
 {
     return bootprof_tsc_mhz ? cycles / bootprof_tsc_mhz : 0;
