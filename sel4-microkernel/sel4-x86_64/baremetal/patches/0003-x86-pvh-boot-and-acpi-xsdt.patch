@@ -271,6 +271,24 @@ BEGIN_FUNC(common_init)
     ret
 END_FUNC(common_init)
 
+/* PVH entry (XEN_ELFNOTE_PHYS32_ENTRY): 32-bit protected mode, paging off,
+ * %ebx = struct hvm_start_info paddr. Reuse the multiboot path with a magic
+ * that boot_sys() recognises. */
+BEGIN_FUNC(_start_pvh)
+    movl $0x336ec578, %eax /* PVH_START_MAGIC */
+    jmp _start
+END_FUNC(_start_pvh)
+
+.section .note.pvh, "a", @note
+    .align 4
+    .long 4               /* namesz: "Xen\0" */
+    .long 4               /* descsz */
+    .long 18              /* XEN_ELFNOTE_PHYS32_ENTRY */
+    .asciz "Xen"
+    .align 4
+    .long _start_pvh
+.previous
+
 BEGIN_FUNC(_start)
     /* Assume we are MultiBooted, e.g. by GRUB.
      * While not immediately checked, the magic number is checked prior to 
