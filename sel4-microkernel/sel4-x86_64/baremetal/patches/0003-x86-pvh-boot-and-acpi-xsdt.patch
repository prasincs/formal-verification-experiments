@@ -235,6 +235,42 @@ BOOT_CODE static void *acpi_table_init(void *entry, enum acpi_type table_type)
     return acpi_table;
 }
 
+/* Root table: the RSDT when present, else the XSDT (ACPI 2.0+). MicroVM VMMs
+ * (QEMU microvm, Firecracker, Cloud Hypervisor) provide only an XSDT. Tables
+ * above 4 GiB are not reachable from boot code and are skipped. */
+BOOT_CODE static acpi_rsdt_t *acpi_root(acpi_rsdp_t *rsdp, word_t *entry_bytes)
+{
+    acpi_rsdt_t *root;
+    if (rsdp->rsdt_address) {
+        *entry_bytes = sizeof(uint32_t);
+        root = acpi_table_init((void *)(word_t)rsdp->rsdt_address, ACPI_RSDT);
+    } else if (rsdp->revision >= 2 && rsdp->xsdt_address && rsdp->xsdt_address < BIT(32)) {
+        *entry_bytes = sizeof(uint64_t);
+        root = acpi_table_init((void *)(word_t)rsdp->xsdt_address, ACPI_RSDT);
+    } else {
+        printf("ACPI: no usable RSDT or XSDT\n");
+        return NULL;
+    }
+    if (root->header.length < sizeof(acpi_header_t)) {
+        printf("ACPI: root table length %u invalid\n", root->header.length);
+        return NULL;
+    }
+    return root;
+}
+
+BOOT_CODE static word_t acpi_root_count(acpi_rsdt_t *root, word_t entry_bytes)
+{
+    return (root->header.length - sizeof(acpi_header_t)) / entry_bytes;
+}
+
+/* Entry i as a pointer, or NULL if above 4 GiB. XSDT entries are unaligned. */
+BOOT_CODE static void *acpi_root_entry(acpi_rsdt_t *root, word_t entry_bytes, word_t i)
+{
+    uint64_t paddr = 0;
+    memcpy(&paddr, (char *)root->entry + i * entry_bytes, entry_bytes);
+    return paddr < BIT(32) ? (void *)(word_t)paddr : NULL;
+}
