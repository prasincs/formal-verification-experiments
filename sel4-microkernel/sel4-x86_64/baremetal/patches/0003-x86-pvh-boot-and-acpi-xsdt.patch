+/* Root table: the XSDT when the RSDP is ACPI 2.0+ and the XSDT is reachable
+ * (the spec says 64-bit OSes should use it, and microVM VMMs such as QEMU
+ * microvm, Firecracker and Cloud Hypervisor provide only an XSDT), else the
+ * RSDT. Boot code only maps the low 4 GiB; tables above it are skipped with
+ * a warning, and acpi_has_high_tables() lets callers fail closed. */
+BOOT_CODE static acpi_rsdt_t *acpi_root(acpi_rsdp_t *rsdp, word_t *entry_bytes)
+{
+    acpi_rsdt_t *root;
+    if (rsdp->revision >= 2 && rsdp->xsdt_address && rsdp->xsdt_address < BIT(32)) {
+        *entry_bytes = sizeof(uint64_t);
+        root = acpi_table_init((void *)(word_t)rsdp->xsdt_address, ACPI_RSDT);
+    } else if (rsdp->rsdt_address) {
+        *entry_bytes = sizeof(uint32_t);
+        root = acpi_table_init((void *)(word_t)rsdp->rsdt_address, ACPI_RSDT);
+    } else {
+        printf("ACPI: no usable RSDT or XSDT\n");
+        return NULL;
+    }
+    if (root->header.length < sizeof(acpi_header_t)) {
+        printf("ACPI: root table length %u invalid\n", root->header.length);
+        return NULL;
+    }
+    return root;
+}
+
+BOOT_CODE static word_t acpi_root_count(acpi_rsdt_t *root, word_t entry_bytes)
+{
+    return (root->header.length - sizeof(acpi_header_t)) / entry_bytes;
+}
+
+/* Entry i as a pointer, or NULL if above 4 GiB. XSDT entries are unaligned. */
+BOOT_CODE static void *acpi_root_entry(acpi_rsdt_t *root, word_t entry_bytes, word_t i)
+{
+    uint64_t paddr = 0;
+    memcpy(&paddr, (char *)root->entry + i * entry_bytes, entry_bytes);
+    if (paddr >= BIT(32)) {
+        printf("ACPI: table at 0x%llx is above 4 GiB, skipped\n", (unsigned long long)paddr);
+        return NULL;
+    }
+    return (void *)(word_t)paddr;
+}
+
+BOOT_CODE bool_t acpi_has_high_tables(acpi_rsdp_t *acpi_rsdp)
+{
+    word_t entry_bytes;
+    acpi_rsdt_t *root = acpi_root(acpi_rsdp, &entry_bytes);
+    if (!root) {
+        return false;
+    }
+    for (word_t i = 0; i < acpi_root_count(root, entry_bytes); i++) {
+        uint64_t paddr = 0;
+        memcpy(&paddr, (char *)root->entry + i * entry_bytes, entry_bytes);
+        if (paddr >= BIT(32)) {
+            return true;
+        }
+    }
+    return false;
+}
